# Secrets: never commit
.env
.env.local
*.pem
*.key
*.crt
*.p12
# PowerShell credentials exported with Export-Clixml
*.cred
*.credential.xml

# Local tooling and session artifacts
# .claude/ can contain local plans, session context, and scratch files. It is
# not necessarily secret, but it is not project documentation for a public repository.
.claude/

# Local Graphify map for coding agents (see AGENTS.md). It is regenerated on
# demand and can absorb local agent notes from graphify-out/memory/, so it is
# never published.
graphify-out/

# Test and build output
testResults*.xml
coverage*.xml
output/
dist/
build/

# Logs and data
*.log
logs/
reputation-cache.json
*.csv
!tests/**/*.csv

# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
