transmissions/
NOTES-ENTRETIEN.md
blueprint*.md

# Test and build output
testResults*.xml
coverage*.xml
output/
dist/
build/

# Logs and data
*.log
logs/
*.csv
!tests/**/*.csv

# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
